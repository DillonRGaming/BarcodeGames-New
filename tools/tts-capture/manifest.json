{
  "manifest_version": 3,
  "name": "TTS Capture",
  "version": "1.0",
  "content_scripts": [
    {
      "matches": [
        "https://www.101soundboards.com/tts/*",
        "https://101soundboards.com/tts/*"
      ],
      "js": ["capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
